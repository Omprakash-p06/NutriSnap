flowchart LR
    subgraph Input
        A1[Overhead RGB] --> P1
        A2[Overhead Depth] --> P2
        A3[Side RGB] --> P3
    end

    subgraph Preprocessing
        P1[Resize 224, ImageNet norm] --> S1[SAM Segmentation\n+ mask]
        P2[Depth cleaning\n+ inpainting] --> S1
        P3[Resize 224, ImageNet norm] --> S2[Zero depth map]
        S1 --> F[RGB-D fusion\n+ attention]
        S2 --> F
        F --> Aug[Online augmentation]
    end

    subgraph Output
        Aug --> T[To model]
    end