# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_32_char_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI / LLM Configuration ────────────────────────────────────────────────────
# Gemini 2.5+ is the preferred stable family now.
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# LLM provider options: local | gemini | openrouter | openai
# Set to "local" to use an on-device model via Ollama (no API key exhaustion!)
# Fallback chain: local → gemini → openrouter → openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENAI_MODEL=gpt-4o-mini

# Optional alternative keys (used automatically if Gemini rate-limits or is unavailable)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_API_KEY_FALLBACK=
OPENAI_API_KEY=your_openai_key_here

# ── Local LLM (Ollama / llama.cpp) ───────────────────────────────────────────
# Requirements: install Ollama from https://ollama.com, then run:
#   ollama pull gemma4:2b      (fits in ~2.4GB VRAM — recommended for RTX 3050)
#   ollama pull gemma4:4b      (needs ~3.8GB VRAM — smarter JSON output)
#   ollama serve               (starts the local API on port 11434)
#
# Then set LLM_PROVIDER=local above. Gemini is used as fallback if Ollama is offline.
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma4:2b
LOCAL_LLM_TIMEOUT=90

# ── Hugging Face (optional) ───────────────────────────────────────────────────
# Override the default HF cache directory (default: ~/.cache/huggingface/)
# Useful on machines with limited home-dir space.
# HF_HOME=/data/hf_cache

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Set to false to enable real AI inference (requires GPU or patience on CPU)
# Set to true for fast mock responses during frontend development
SKIP_AI_INIT=false

# ── API / CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
