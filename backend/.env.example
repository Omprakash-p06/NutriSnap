# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_32_char_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI / LLM Configuration ────────────────────────────────────────────────────
# Gemini 2.5+ is the preferred stable family now.
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# LLM provider options: local | gemini | openrouter | openai
# Set to "local" to use an on-device model via Ollama (no API key exhaustion!)
# Fallback chain: local → gemini → openrouter → openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENAI_MODEL=gpt-4o-mini

# Optional alternative keys (used automatically if Gemini rate-limits or is unavailable)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_API_KEY_FALLBACK=
OPENAI_API_KEY=your_openai_key_here

# ── Local LLM (llama.cpp via llama-cpp-python) ───────────────────────────────
# llama.cpp runs Gemma 4 directly on your hardware with ZERO API keys.
# Hardware is auto-detected in priority: CUDA > Vulkan > OpenVINO > CPU
#
# One-time setup (detects HW, installs correct build, downloads GGUF model):
#   python scripts/setup_local_llm.py
#
# Then start the llama.cpp server before running the backend:
#   python -m nutrisnap.utils.local_llm_backend serve --model models/llm/gemma-4-2b-q4_k_m.gguf
#
# Set LLM_PROVIDER=local below. Gemini is used as fallback if server is offline.
#
# LLAMA_BACKEND override options: cuda | vulkan | openvino | cpu (auto if unset)
# LLAMA_N_GPU_LAYERS: layers to offload to GPU (-1 = auto from VRAM)
LOCAL_LLM_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=gemma-4-2b-q4_k_m
LOCAL_LLM_TIMEOUT=90
# LLAMA_BACKEND=cuda
# LLAMA_N_GPU_LAYERS=26
# LLAMA_PORT=8000
# LLAMA_N_THREADS=4

# ── Hugging Face (optional) ───────────────────────────────────────────────────
# Override the default HF cache directory (default: ~/.cache/huggingface/)
# Useful on machines with limited home-dir space.
# HF_HOME=/data/hf_cache

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Set to false to enable real AI inference (requires GPU or patience on CPU)
# Set to true for fast mock responses during frontend development
SKIP_AI_INIT=false

# ── API / CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
