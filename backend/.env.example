MONGO_URI=mongodb://localhost:27017
MONGO_DB=nutrisnap

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_32_char_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI / LLM Configuration ────────────────────────────────────────────────────
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM provider options: gemini | openrouter | openai | groq
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Optional alternative keys (only needed if using openrouter/openai/groq)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=gsk_...TpVh

# ── Hugging Face (optional) ───────────────────────────────────────────────────
# Override the default HF cache directory (default: ~/.cache/huggingface/)
# Useful on machines with limited home-dir space.
# HF_HOME=/data/hf_cache

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Set to false to enable real AI inference (requires GPU or patience on CPU)
# Set to true for fast mock responses during frontend development
SKIP_AI_INIT=false

# ── API / CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
