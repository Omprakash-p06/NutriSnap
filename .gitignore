# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
env/
.venv/
backend/venv/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
# Keep .env.example so collaborators know what's needed
!.env.example

# ── Linting / Type-checking Cache ─────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pylint.d/

# ── Testing / Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ── Node.js (Frontend) ────────────────────────────────────────────────────────
node_modules/
dist/
build/
dev-dist/
frontend/dist/
frontend/dev-dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.parcel-cache

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite3
backend/nutrisnap.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
backend/logs/

# ── Temporary / Scratch ───────────────────────────────────────────────────────
tmp/
scratch/
backend/scratch/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
__MACOSX/
*.swp
*.swo

# ── AI / Agent files ──────────────────────────────────────────────────────────
.gemini/
.agent/
.agents/
kaggle_files.txt

# ── Machine Learning Models & Weights ─────────────────────────────────────────
# NOTE: Do NOT commit model weights. Run `python scripts/download_models.py`
# after cloning to download all required weights automatically.

# YOLOv8 weights (downloaded automatically by Ultralytics on first use)
*.pt
*.pth
*.ckpt
*.pkl

# HuggingFace cache (lives in ~/.cache/huggingface/ — never in repo)
# If you override HF_HOME to a path inside this repo, add it here

# Custom joblib models in backend/models/ are committed (they are tiny)
!backend/models/*.joblib
!backend/models/*.json

# GGUF models for local LLM inference (large binary files — download via setup script)
# Run: python scripts/setup_local_llm.py
backend/models/llm/
*.gguf

# Jupyter checkpoints
.ipynb_checkpoints/

# Experiment tracking
wandb/
runs/
checkpoints/
reports/figures/
*.egg-info/

# ── Datasets (local only, never committed) ────────────────────────────────────
backend/datasets/uploads/
backend/datasets/interim/
backend/datasets/processed/
backend/datasets/splits/
backend/datasets/raw/
ml/datasets/

# ── Third-party checkpoints ───────────────────────────────────────────────────
third_party/**/checkpoints/
third_party/**/*.pth
third_party/**/*.pt
third_party/**/*.ckpt
third_party/**/*.pkl
!third_party/**/.gitkeep
